{
	"name": "unplugin-inline-functions",
	"version": "0.6.0",
	"description": "Universal plugin to inline functions in your code. Works with Vite, Rollup, Webpack, esbuild, Rolldown, and more.",
	"license": "ISC",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": {
				"import": "./dist/index.d.ts",
				"require": "./dist/index.d.cts"
			},
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"import": "./dist/vite.js",
			"require": "./dist/vite.cjs"
		},
		"./webpack": {
			"types": "./dist/webpack.d.ts",
			"import": "./dist/webpack.js",
			"require": "./dist/webpack.cjs"
		},
		"./rollup": {
			"types": "./dist/rollup.d.ts",
			"import": "./dist/rollup.js",
			"require": "./dist/rollup.cjs"
		},
		"./esbuild": {
			"types": "./dist/esbuild.d.ts",
			"import": "./dist/esbuild.js",
			"require": "./dist/esbuild.cjs"
		},
		"./rolldown": {
			"types": "./dist/rolldown.d.ts",
			"import": "./dist/rolldown.js",
			"require": "./dist/rolldown.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"test": "vitest",
		"typecheck": "tsc --build --noEmit",
		"typecheck:watch": "tsc --build --watch --noEmit",
		"release": "pnpm run build && pnpm publish",
		"lint": "oxlint",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@babel/parser": "^7.28.5",
		"@babel/traverse": "^7.28.5",
		"@babel/types": "^7.28.5",
		"@types/babel__generator": "^7.27.0",
		"@types/babel__traverse": "^7.28.0",
		"@types/node": "latest",
		"chalk": "^5.6.2",
		"esbuild": "^0.25.10",
		"oxlint": "^1.90.0",
		"oxlint-tsgolint": "^7.0.2005",
		"prettier": "^3.9.10",
		"rollup": "^4.53.3",
		"rollup-plugin-esbuild": "^6.2.1",
		"tsdown": "0.23.3",
		"typescript": "7.0.2",
		"vite": "^6.4.1",
		"vitest": "^3.2.4"
	},
	"peerDependencies": {
		"@babel/parser": "^7.26.3",
		"@babel/traverse": "^7.26.4",
		"@babel/types": "^7.26.3"
	},
	"packageManager": "pnpm@12.16.1",
	"dependencies": {
		"@babel/generator": "^7.28.5",
		"fast-glob": "^3.3.3",
		"unplugin": "^2.3.11"
	},
	"engines": {
		"pnpm": ">=12.0.0",
		"node": ">=22.13"
	}
}
